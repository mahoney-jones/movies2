---
interface Props {
  /** Pre-fills the box so a search can be edited rather than retyped. */
  query?: string;
  autofocus?: boolean;
}

const { query = "", autofocus = false } = Astro.props;

// Respect the configured base path so the form works under /movies2/ on Pages.
const action = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/results/`;
---

<form action={action} method="GET" class="flex flex-wrap gap-2">
  <label for="search" class="sr-only">Search for a movie</label>
  <input
    type="search"
    id="search"
    name="search"
    value={query}
    placeholder="e.g. star wars"
    autofocus={autofocus}
    required
    class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base shadow-sm placeholder:text-slate-400 focus-visible:border-sky-500 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:placeholder:text-slate-500"
  />
  <button
    type="submit"
    class="rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white shadow-sm transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"
  >
    Search
  </button>
</form>
