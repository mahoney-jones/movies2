---
import Layout from "../layouts/Layout.astro";

const home = import.meta.env.BASE_URL;
---

<Layout title="Page not found — Movies">
  <div class="py-16 text-center">
    <p class="text-5xl font-bold tracking-tight">404</p>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      We couldn’t find that page.
    </p>
    <a
      href={home}
      class="mt-6 inline-block rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white shadow-sm transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"
    >
      Back to search
    </a>
  </div>
</Layout>
