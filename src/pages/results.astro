---
import Layout from "../layouts/Layout.astro";
import SearchForm from "../components/SearchForm.astro";

// Prerendered: the page is a static shell and the search runs in the browser,
// so the whole site can be hosted on static hosting such as GitHub Pages.
export const prerender = true;
---

<Layout title="Results — Movies">
  <div class="mb-8">
    <SearchForm />
  </div>

  <div id="status" role="status" aria-live="polite">
    <p class="text-sm text-slate-500 dark:text-slate-400">Searching…</p>
  </div>

  <div
    id="results"
    class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
  </div>

  <nav
    id="pagination"
    aria-label="Search results pages"
    class="mt-10 flex items-center justify-center gap-4"
  >
  </nav>
</Layout>

<script>
  import { createMovieCard } from "../lib/movie-card";
  import { fetchPostered, markPosterDead } from "../lib/paging";
  import { OMDB_API_KEY, OMDB_BASE_URL } from "astro:env/client";

  const base = import.meta.env.BASE_URL;
  const statusEl = document.querySelector<HTMLElement>("#status")!;
  const resultsEl = document.querySelector<HTMLElement>("#results")!;
  const pagerEl = document.querySelector<HTMLElement>("#pagination")!;
  const formInput = document.querySelector<HTMLInputElement>("#search")!;

  /** Renders a message block. Text goes through textContent, never innerHTML. */
  function showMessage(text: string, detail: string, tone: "info" | "error") {
    const box = document.createElement("div");
    box.className =
      tone === "error"
        ? "rounded-xl border border-red-200 bg-red-50 p-8 text-center dark:border-red-900/50 dark:bg-red-950/30"
        : "rounded-xl border border-slate-200 bg-white p-8 text-center dark:border-slate-800 dark:bg-slate-900";

    const heading = document.createElement("p");
    heading.className =
      tone === "error"
        ? "text-lg font-medium text-red-800 dark:text-red-200"
        : "text-lg font-medium";
    heading.textContent = text;

    const body = document.createElement("p");
    body.className =
      tone === "error"
        ? "mt-2 text-sm text-red-700 dark:text-red-300"
        : "mt-2 text-sm text-slate-500 dark:text-slate-400";
    body.textContent = detail;

    box.append(heading, body);
    statusEl.replaceChildren(box);
  }

  /**
   * Pages are filled from as many upstream pages as it takes, so positions no
   * longer line up with OMDB's own numbering — a "1–10 of 83" range would be
   * meaningless. The count states what is on screen against the unfiltered
   * total, and says plainly that titles are being hidden.
   */
  function showCount(shown: number, total: number, query: string) {
    const heading = document.createElement("h1");
    heading.className = "mb-1 text-2xl font-bold tracking-tight";
    heading.textContent = `Results for “${query}”`;

    const count = document.createElement("p");
    count.className = "mb-6 text-sm text-slate-500 dark:text-slate-400";
    count.id = "result-count";
    count.textContent = `Showing ${shown.toLocaleString()} of ${total.toLocaleString()} matches · titles without a poster are hidden`;

    statusEl.replaceChildren(heading, count);
  }

  /** Nothing left with artwork — either past the end, or none survived. */
  function showNothingOnPage(query: string) {
    const heading = document.createElement("h1");
    heading.className = "mb-1 text-2xl font-bold tracking-tight";
    heading.textContent = `Results for “${query}”`;

    const box = document.createElement("div");
    box.className =
      "rounded-xl border border-slate-200 bg-white p-8 text-center dark:border-slate-800 dark:bg-slate-900";
    const line = document.createElement("p");
    line.className = "text-sm text-slate-500 dark:text-slate-400";
    line.textContent = "No more titles with posters for this search.";
    box.append(line);

    statusEl.replaceChildren(heading, box);
  }

  /**
   * Prev/Next links that navigate by rewriting the page query parameter.
   * A total page count is not knowable — how many pages the filtered results
   * fill depends on how many titles get hidden further in — so Next is driven
   * by whether more survivors exist.
   */
  function renderPagination(current: number, hasNext: boolean) {
    pagerEl.replaceChildren();
    if (current === 1 && !hasNext) return;

    const link = (target: number, label: string, rel: "prev" | "next") => {
      const url = new URL(window.location.href);
      url.searchParams.set("page", String(target));
      const a = document.createElement("a");
      a.href = url.pathname + url.search;
      a.rel = rel;
      a.textContent = label;
      a.className =
        "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium shadow-sm transition hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800";
      return a;
    };

    if (current > 1) pagerEl.append(link(current - 1, "← Previous", "prev"));

    const status = document.createElement("span");
    status.className = "text-sm text-slate-500 dark:text-slate-400";
    status.textContent = `Page ${current.toLocaleString()}`;
    pagerEl.append(status);

    if (hasNext) pagerEl.append(link(current + 1, "Next →", "next"));
  }

  async function run() {
    const url = new URL(window.location.href);
    const query = url.searchParams.get("search")?.trim();

    // Nothing to search for — send them back to the form.
    if (!query) {
      window.location.replace(base);
      return;
    }

    let page = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
    if (!Number.isFinite(page) || page < 1) page = 1;

    document.title = `${query} — Movies`;
    formInput.value = query;

    await render(query, page);
  }

  async function render(query: string, page: number) {
    // Pulls from as many upstream pages as it takes to fill a full page of
    // titles that have artwork, rather than filtering a single upstream page
    // and leaving a short grid behind.
    const result = await fetchPostered(
      query,
      { baseUrl: OMDB_BASE_URL, apiKey: OMDB_API_KEY },
      page,
    );

    if (result.status === "error") {
      showMessage("Something went wrong", result.message, "error");
      return;
    }

    if (result.status === "empty") {
      showMessage(
        `No results for “${query}”`,
        `${result.message} Try a different search term.`,
        "info",
      );
      return;
    }

    if (result.movies.length === 0) {
      showNothingOnPage(query);
      renderPagination(page, false);
      return;
    }

    // Every title here advertises a poster, but some URLs are dead — only
    // discoverable by trying to load them. Recording the failure and
    // re-rendering pulls a replacement in from the already-cached upstream
    // pages, so the page stays full instead of dropping to nine. Each failure
    // adds a URL to the dead set, so this converges.
    const onPosterUnavailable = (movie: { Poster: string }) => {
      if (markPosterDead(movie.Poster)) void render(query, page);
    };

    showCount(result.movies.length, result.total, query);
    resultsEl.replaceChildren(
      ...result.movies.map((movie) =>
        createMovieCard(movie, () => onPosterUnavailable(movie)),
      ),
    );
    renderPagination(page, result.hasNext);
  }

  run();
</script>
