---
import Layout from "../layouts/Layout.astro";
import MovieCard from "../components/MovieCard.astro";
import SearchForm from "../components/SearchForm.astro";
import { searchMovies } from "../lib/omdb";

// Results depend on the query string, so this page is rendered per request.
export const prerender = false;

const query = Astro.url.searchParams.get("search")?.trim() ?? "";

// Nothing to search for — send them back to the form rather than calling OMDB.
if (!query) {
  return Astro.redirect("/");
}

const result = await searchMovies(query);

// Surface upstream failures as a gateway error rather than a misleading 200.
if (result.status === "error") {
  Astro.response.status = 502;
}
---

<Layout title={`${query} — Movies`}>
  <div class="mb-8">
    <SearchForm query={query} />
  </div>

  {
    result.status === "ok" && (
      <>
        <h1 class="mb-1 text-2xl font-bold tracking-tight">
          Results for “{query}”
        </h1>
        <p class="mb-6 text-sm text-slate-500 dark:text-slate-400">
          Showing {result.movies.length} of {result.total.toLocaleString()}{" "}
          {result.total === 1 ? "match" : "matches"}
        </p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
          {result.movies.map((movie) => (
            <MovieCard movie={movie} />
          ))}
        </div>
      </>
    )
  }

  {
    result.status === "empty" && (
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center dark:border-slate-800 dark:bg-slate-900">
        <p class="text-lg font-medium">No results for “{query}”</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          {result.message} Try a different search term.
        </p>
      </div>
    )
  }

  {
    result.status === "error" && (
      <div class="rounded-xl border border-red-200 bg-red-50 p-8 text-center dark:border-red-900/50 dark:bg-red-950/30">
        <p class="text-lg font-medium text-red-800 dark:text-red-200">
          Something went wrong
        </p>
        <p class="mt-2 text-sm text-red-700 dark:text-red-300">
          {result.message}
        </p>
      </div>
    )
  }
</Layout>
